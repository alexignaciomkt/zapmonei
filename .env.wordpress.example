# ============================================================
# Variáveis de ambiente - WordPress ZapMonei
# COPIE este arquivo para a VPS como: .env.wordpress
# NUNCA commite este arquivo no Git!
# ============================================================

# Banco de dados
WP_DB_ROOT_PASSWORD=TROQUE_POR_SENHA_FORTE_ROOT
WP_DB_NAME=zapmonei_wp
WP_DB_USER=zapmonei_wp_user
WP_DB_PASSWORD=TROQUE_POR_SENHA_FORTE_DB

# ============================================================
# INSTRUÇÕES PARA PREENCHER:
# 1. Substitua os valores acima por senhas seguras
#    Use: openssl rand -base64 24  (para gerar senhas)
# 2. Salve como .env.wordpress na VPS
# 3. Execute: docker compose --env-file .env.wordpress -f docker-compose.wordpress.yml up -d
# ============================================================
