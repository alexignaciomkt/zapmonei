{
  "name": "ZapMonei: Ativação Pós-Pagamento (Completo)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "asaas-payment-webhook",
        "options": {}
      },
      "id": "webhook-asaas",
      "name": "Webhook: Pagamento Recebido",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [ 0, 400 ]
    },
    {
      "parameters": {
        "operation": "upsert",
        "tableId": "users",
        "columnToMatchOn": "whatsapp_number",
        "fieldsUi": {
          "fieldValues": [
            { "fieldId": "nome", "fieldValue": "={{ $json.body.customer_name }}" },
            { "fieldId": "whatsapp_number", "fieldValue": "={{ $json.body.customer_phone }}" },
            { "fieldId": "plan", "fieldValue": "={{ $json.body.plan }}" },
            { "fieldId": "onboarding_status", "fieldValue": "pending_kathy" }
          ]
        }
      },
      "id": "supabase-upsert-user",
      "name": "Supabase: Criar/Atualizar Usuário",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [ 220, 400 ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://apigo.euattendo.com.br/instance/create",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "0326ad2f6fcc4cb57e1e132812b1e1e1" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"name\": \"zapmonei_{{ $json.whatsapp_number }}\",\n  \"token\": \"{{ $json.id }}\"\n}",
        "options": { "continueOnFail": true }
      },
      "id": "evogo-create-instance",
      "name": "Evo-Go: Criar Instância",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [ 440, 400 ]
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "users",
        "filters": {
          "conditions": [
            { "keyName": "id", "condition": "eq", "keyValue": "={{ $node[\"Supabase: Criar/Atualizar Usuário\"].json.id }}" }
          ]
        },
        "fieldsUi": {
          "fieldValues": [
            { "fieldId": "whatsapp_instance_name", "fieldValue": "zapmonei_{{ $node[\"Supabase: Criar/Atualizar Usuário\"].json.whatsapp_number }}" },
            { "fieldId": "whatsapp_instance_token", "fieldValue": "={{ $node[\"Supabase: Criar/Atualizar Usuário\"].json.id }}" }
          ]
        }
      },
      "id": "supabase-update-token",
      "name": "Supabase: Salvar Dados Instância",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [ 660, 400 ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://apigo.euattendo.com.br/settings/set/zapmonei_{{ $node[\"Supabase: Criar/Atualizar Usuário\"].json.whatsapp_number }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "0326ad2f6fcc4cb57e1e132812b1e1e1" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"rejectCall\": true,\n  \"msgCall\": \"No momento só respondo por mensagens de texto e áudio! 💬\",\n  \"groupsIgnore\": true,\n  \"ignoreHistorics\": true,\n  \"ignoreBroadcasts\": true,\n  \"readMessages\": true\n}",
        "options": { "continueOnFail": true }
      },
      "id": "evogo-set-settings",
      "name": "EvoGo: Configurar Regras",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [ 880, 400 ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://apigo.euattendo.com.br/instance/connect",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "0326ad2f6fcc4cb57e1e132812b1e1e1" },
            { "name": "instance", "value": "zapmonei_{{ $node[\"Supabase: Criar/Atualizar Usuário\"].json.whatsapp_number }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"instance\": \"zapmonei_{{ $node[\"Supabase: Criar/Atualizar Usuário\"].json.whatsapp_number }}\",\n  \"webhookUrl\": \"https://webhook.euattendo.com.br/webhook/whatsapp/inbound\",\n  \"subscribe\": [\"MESSAGES_UPSERT\", \"MESSAGES_UPDATE\", \"CONNECTION_UPDATE\"]\n}",
        "options": { "continueOnFail": true }
      },
      "id": "evogo-set-webhook",
      "name": "EvoGo: Configurar Webhook (Connect)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [ 1100, 400 ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://apigo.euattendo.com.br/message/sendText/zapmonei_suporte",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "0326ad2f6fcc4cb57e1e132812b1e1e1" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"number\": \"{{ $node[\"Supabase: Criar/Atualizar Usuário\"].json.whatsapp_number }}\",\n  \"text\": \"👋 Olá, {{ $node[\"Supabase: Criar/Atualizar Usuário\"].json.nome }}! Eu sou a *Kathy*, a chefe dos assistentes aqui no ZapMonei!\\n\\nSeu plano foi ativado com sucesso ✅\\n\\nEstou preparando um assistente financeiro novinho em folha só pra você! 🤖✨\\n\\nMas antes, preciso conectar ele ao seu WhatsApp.\\nMe diz uma coisa:\\n\\n*Você está usando agora o celular que vai usar com o seu assistente?*\\n\\n1️⃣ Sim, estou neste celular\\n2️⃣ Não, vou usar outro aparelho\"\n}"
      },
      "id": "kathy-boas-vindas",
      "name": "Kathy: Boas-Vindas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [ 1320, 400 ]
    }
  ],
  "connections": {
    "Webhook: Pagamento Recebido": { "main": [ [ { "node": "Supabase: Criar/Atualizar Usuário", "type": "main", "index": 0 } ] ] },
    "Supabase: Criar/Atualizar Usuário": { "main": [ [ { "node": "Evo-Go: Criar Instância", "type": "main", "index": 0 } ] ] },
    "Evo-Go: Criar Instância": { "main": [ [ { "node": "Supabase: Salvar Dados Instância", "type": "main", "index": 0 } ] ] },
    "Supabase: Salvar Dados Instância": { "main": [ [ { "node": "EvoGo: Configurar Regras", "type": "main", "index": 0 } ] ] },
    "EvoGo: Configurar Regras": { "main": [ [ { "node": "EvoGo: Configurar Webhook (Connect)", "type": "main", "index": 0 } ] ] },
    "EvoGo: Configurar Webhook (Connect)": { "main": [ [ { "node": "Kathy: Boas-Vindas", "type": "main", "index": 0 } ] ] }
  }
}
