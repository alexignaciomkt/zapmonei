  "content": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;700;900&display=swap');\n    body { font-family: 'Outfit', sans-serif; background: #050505; color: #fff; margin: 0; }\n    .hero-neon { min-height: 90vh; display: flex; align-items: center; position: relative; overflow: hidden; }\n    .text-gradient { background: linear-gradient(90deg, #fff, #CCFF00); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }\n    .hero-image img { animation: float 6s ease-in-out infinite; }\n    @keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-20px); } }\n    .chat-simulation { position: absolute; bottom: 20px; left: -30px; width: 280px; z-index: 10; }\n    .chat-bubble { background: rgba(255,255,255,0.1); backdrop-filter: blur(15px); border: 1px solid rgba(255,255,255,0.1); border-radius: 20px; padding: 15px; margin-bottom: 10px; font-size: 14px; box-shadow: 0 10px 30px rgba(0,0,0,0.3); opacity: 0; transform: translateY(20px); animation: fadeInUp 0.5s forwards; }\n    @keyframes fadeInUp { to { opacity: 1; transform: translateY(0); } }\n    .bubble-1 { animation-delay: 1s; }\n    .bubble-2 { animation-delay: 3s; border-left: 4px solid #CCFF00; }\n    .btn-neon { background: #CCFF00; color: #050505; padding: 18px 40px; border-radius: 20px; font-weight: bold; text-decoration: none; display: inline-block; transition: all 0.3s; box-shadow: 0 10px 20px rgba(204, 255, 0, 0.2); }\n    .btn-neon:hover { transform: scale(1.05); box-shadow: 0 15px 30px rgba(204, 255, 0, 0.4); }\n    .card-pricing { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 30px; padding: 40px; text-align: center; transition: all 0.3s; }\n    .card-pricing.highlight { border-color: #CCFF00; background: rgba(204, 255, 0, 0.02); transform: scale(1.05); }\n    .card-pricing:hover { transform: translateY(-10px); background: rgba(255,255,255,0.05); }\n</style>\n\n<section class=\"hero-neon\">\n    <div class=\"glow\" style=\"position: absolute; top: -10%; right: -10%; width: 50%; height: 50%; background: rgba(204, 255, 0, 0.1); filter: blur(120px); border-radius: 50%;\"></div>\n    <div style=\"max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; padding: 0 20px;\">\n        <div class=\"hero-text\">\n            <span style=\"background: rgba(204, 255, 0, 0.1); border: 1px solid rgba(204, 255, 0, 0.2); color: #CCFF00; padding: 6px 18px; border-radius: 50px; font-size: 12px; font-weight: bold; text-transform: uppercase; letter-spacing: 1px;\">🚀 NOVO: GESTÃO FAMILIAR LIBERADA</span>\n            <h1 style=\"font-size: 5rem; line-height: 0.85; margin: 25px 0; font-weight: 900; letter-spacing: -3px; color: #fff;\">Sua meta de hoje <br><span class=\"text-gradient\">no seu bolso.</span></h1>\n            <p style=\"opacity: 0.6; font-size: 1.3rem; line-height: 1.6; margin-bottom: 45px; max-width: 500px;\">O ZapMonei é o seu novo Sócio-Assistente. Controle cada ganho e gasto pelo WhatsApp com IA. Simples, rápido e fora da curva.</p>\n            <div style=\"display: flex; gap: 25px;\">\n                <a href=\"#pricing\" class=\"btn-neon\">Começar 3 Dias Grátis</a>\n                <a href=\"#features\" style=\"background: rgba(255,255,255,0.05); color: #fff; padding: 18px 40px; border-radius: 20px; font-weight: bold; text-decoration: none; backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.1);\">Ver Como Funciona</a>\n            </div>\n        </div>\n        <div class=\"hero-image\" style=\"position: relative;\">\n            <img src=\"https://zapmonei.com.br/wp-content/uploads/2026/05/zapmonei_hero_driver_1778630506684.jpg\" style=\"width: 100%; border-radius: 50px; box-shadow: 0 30px 100px rgba(0,0,0,0.8); border: 1px solid rgba(255,255,255,0.1);\">\n            <div class=\"chat-simulation\">\n                <div class=\"chat-bubble bubble-1\">\"Gastei R$ 50 de combustível agora\"</div>\n                <div class=\"chat-bubble bubble-2\"><strong>✅ Registrado!</strong><br>Seu lucro projetado hoje é de R$ 180. 🚀</div>\n            </div>\n        </div>\n    </div>\n</section>\n\n<section class=\"stats\" style=\"padding: 80px 0; background: rgba(255,255,255,0.02); border-top: 1px solid rgba(255,255,255,0.05); border-bottom: 1px solid rgba(255,255,255,0.05);\">\n    <div style=\"max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: repeat(4, 1fr); gap: 40px; text-align: center;\">\n        <div><div style=\"font-size: 3rem; font-weight: 900; color: #fff;\">5k+</div><div style=\"color: #CCFF00; text-transform: uppercase; font-size: 10px; font-weight: 900; letter-spacing: 2px;\">Motoristas Ativos</div></div>\n        <div><div style=\"font-size: 3rem; font-weight: 900; color: #fff;\">R$ 2M+</div><div style=\"color: #CCFF00; text-transform: uppercase; font-size: 10px; font-weight: 900; letter-spacing: 2px;\">Lucro Gerenciado</div></div>\n        <div><div style=\"font-size: 3rem; font-weight: 900; color: #fff;\">98%</div><div style=\"color: #CCFF00; text-transform: uppercase; font-size: 10px; font-weight: 900; letter-spacing: 2px;\">Satisfação</div></div>\n        <div><div style=\"font-size: 3rem; font-weight: 900; color: #fff;\">12s</div><div style=\"color: #CCFF00; text-transform: uppercase; font-size: 10px; font-weight: 900; letter-spacing: 2px;\">Tempo de Registro</div></div>\n    </div>\n</section>\n\n<section id=\"family\" style=\"padding: 120px 20px;\">\n    <div style=\"max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center;\">\n        <div style=\"position: relative;\">\n            <div style=\"position: absolute; -inset: 20px; background: rgba(204, 255, 0, 0.1); blur: 50px; border-radius: 50%;\"></div>\n            <img src=\"https://zapmonei.com.br/wp-content/uploads/2026/05/zapmonei_family_finance_1778630520033.jpg\" style=\"width: 100%; border-radius: 40px; position: relative; z-index: 2; border: 1px solid rgba(255,255,255,0.1);\">\n        </div>\n        <div>\n            <h2 style=\"font-size: 3.5rem; font-weight: 900; line-height: 1; margin-bottom: 30px;\">Sua família em <br><span style=\"color: #CCFF00;\">sintonia total.</span></h2>\n            <p style=\"opacity: 0.6; font-size: 1.2rem; line-height: 1.6; margin-bottom: 30px;\">No Plano Pro, você e sua esposa(o) podem acompanhar as finanças em tempo real. Cada um com seu acesso, mas com um só objetivo: o futuro da família.</p>\n            <ul style=\"list-style: none; padding: 0; margin-bottom: 40px;\">\n                <li style=\"margin-bottom: 15px; display: flex; align-items: center; gap: 15px; font-weight: bold;\"><span style=\"color: #CCFF00;\">✓</span> 2 Acessos Simultâneos</li>\n                <li style=\"margin-bottom: 15px; display: flex; align-items: center; gap: 15px; font-weight: bold;\"><span style=\"color: #CCFF00;\">✓</span> Dashboard Compartilhado</li>\n                <li style=\"margin-bottom: 15px; display: flex; align-items: center; gap: 15px; font-weight: bold;\"><span style=\"color: #CCFF00;\">✓</span> Relatórios Domésticos</li>\n            </ul>\n            <a href=\"#pricing\" class=\"btn-neon\">Conhecer Plano Família</a>\n        </div>\n    </div>\n</section>\n\n<section id=\"pricing\" style=\"padding: 120px 20px; background: radial-gradient(circle at center, rgba(204, 255, 0, 0.05) 0%, transparent 70%);\">\n    <div style=\"max-width: 1200px; margin: 0 auto; text-align: center; margin-bottom: 80px;\">\n        <h2 style=\"font-size: 4rem; font-weight: 900; margin-bottom: 20px;\">O investimento que <br><span style=\"color: #CCFF00;\">se paga em 1 dia.</span></h2>\n    </div>\n    <div style=\"max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; align-items: stretch;\">\n        <div class=\"card-pricing\">\n            <h3 style=\"font-size: 1.5rem; margin-bottom: 10px; opacity: 0.7;\">Plano Piloto</h3>\n            <div style=\"font-size: 3.5rem; font-weight: 900; margin-bottom: 30px;\">R$ 49,90<span style=\"font-size: 1rem; opacity: 0.5;\">/mês</span></div>\n            <ul style=\"list-style: none; padding: 0; margin-bottom: 40px; text-align: left; opacity: 0.8;\">\n                <li>• IA Ilimitada</li>\n                <li>• Relatórios Diários</li>\n                <li>• Suporte WhatsApp</li>\n            </ul>\n            <a href=\"/checkout/?add-to-cart=18\" style=\"display: block; padding: 15px; border: 1px solid rgba(255,255,255,0.2); border-radius: 15px; color: #fff; text-decoration: none; font-weight: bold;\">Escolher Piloto</a>\n        </div>\n        <div class=\"card-pricing highlight\">\n            <div style=\"background: #CCFF00; color: #050505; font-size: 10px; font-weight: 900; padding: 5px 15px; border-radius: 50px; display: inline-block; margin-bottom: 20px; text-transform: uppercase;\">Mais Vantajoso</div>\n            <h3 style=\"font-size: 1.5rem; margin-bottom: 10px;\">Plano Anual</h3>\n            <div style=\"font-size: 3.5rem; font-weight: 900; margin-bottom: 30px;\">R$ 397<span style=\"font-size: 1rem; opacity: 0.5;\">/ano</span></div>\n            <ul style=\"list-style: none; padding: 0; margin-bottom: 40px; text-align: left;\">\n                <li>• Economia Real</li>\n                <li>• Acesso Vitalício (enquanto durar)</li>\n                <li>• Suporte Prioritário</li>\n                <li>• IA Inteligência Avançada</li>\n            </ul>\n            <a href=\"/checkout/?add-to-cart=19\" class=\"btn-neon\" style=\"display: block; padding: 15px;\">Escolher Anual</a>\n        </div>\n        <div class=\"card-pricing\">\n            <h3 style=\"font-size: 1.5rem; margin-bottom: 10px; opacity: 0.7;\">Plano Família</h3>\n            <div style=\"font-size: 3.5rem; font-weight: 900; margin-bottom: 30px;\">R$ 59,90<span style=\"font-size: 1rem; opacity: 0.5;\">/mês</span></div>\n            <ul style=\"list-style: none; padding: 0; margin-bottom: 40px; text-align: left; opacity: 0.8;\">\n                <li>• Até 3 Acessos</li>\n                <li>• Gestão Compartilhada</li>\n                <li>• Dashboard Web Pro</li>\n            </ul>\n            <a href=\"/checkout/?add-to-cart=20\" style=\"display: block; padding: 15px; border: 1px solid rgba(255,255,255,0.2); border-radius: 15px; color: #fff; text-decoration: none; font-weight: bold;\">Escolher Família</a>\n        </div>\n    </div>\n</section>\n\n<footer style=\"padding: 100px 20px; border-top: 1px solid rgba(255,255,255,0.05); text-align: center;\">\n    <p style=\"opacity: 0.3;\">© 2026 ZapMonei. Todos os direitos reservados.</p>\n</footer>"
}
