{
  "content": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;700;900&display=swap');\n    body { font-family: 'Outfit', sans-serif; background: #050505; }\n    .hero-neon { min-height: 90vh; display: flex; align-items: center; position: relative; overflow: hidden; }\n    .text-gradient { background: linear-gradient(90deg, #fff, #CCFF00); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }\n    .hero-image img { animation: float 6s ease-in-out infinite; }\n    @keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-20px); } }\n    .chat-simulation { position: absolute; bottom: 20px; left: -30px; width: 280px; z-index: 10; }\n    .chat-bubble { background: rgba(255,255,255,0.1); backdrop-filter: blur(15px); border: 1px solid rgba(255,255,255,0.1); border-radius: 20px; padding: 15px; margin-bottom: 10px; font-size: 14px; box-shadow: 0 10px 30px rgba(0,0,0,0.3); opacity: 0; transform: translateY(20px); animation: fadeInUp 0.5s forwards; }\n    @keyframes fadeInUp { to { opacity: 1; transform: translateY(0); } }\n    .bubble-1 { animation-delay: 1s; }\n    .bubble-2 { animation-delay: 3s; border-left: 4px solid #CCFF00; }\n    .btn-neon { background: #CCFF00; color: #050505; padding: 18px 40px; border-radius: 20px; font-weight: bold; text-decoration: none; display: inline-block; transition: all 0.3s; box-shadow: 0 10px 20px rgba(204, 255, 0, 0.2); }\n    .btn-neon:hover { transform: scale(1.05); box-shadow: 0 15px 30px rgba(204, 255, 0, 0.4); }\n</style>\n\n<section class=\"hero-neon\">\n    <div class=\"glow\" style=\"position: absolute; top: -10%; right: -10%; width: 50%; height: 50%; background: rgba(204, 255, 0, 0.1); filter: blur(120px); border-radius: 50%;\"></div>\n    <div style=\"max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; padding: 0 20px;\">\n        <div class=\"hero-text\">\n            <span style=\"background: rgba(204, 255, 0, 0.1); border: 1px solid rgba(204, 255, 0, 0.2); color: #CCFF00; padding: 6px 18px; border-radius: 50px; font-size: 12px; font-weight: bold; text-transform: uppercase; letter-spacing: 1px;\">🚀 NOVO: GESTÃO FAMILIAR LIBERADA</span>\n            <h1 style=\"font-size: 5rem; line-height: 0.85; margin: 25px 0; font-weight: 900; letter-spacing: -3px; color: #fff;\">Sua meta de hoje <br><span class=\"text-gradient\">no seu bolso.</span></h1>\n            <p style=\"opacity: 0.6; font-size: 1.3rem; line-height: 1.6; margin-bottom: 45px; max-width: 500px;\">O ZapMonei é o seu novo Sócio-Assistente. Controle cada ganho e gasto pelo WhatsApp com IA. Simples, rápido e fora da curva.</p>\n            <div style=\"display: flex; gap: 25px;\">\n                <a href=\"#pricing\" class=\"btn-neon\">Começar 3 Dias Grátis</a>\n                <a href=\"#features\" style=\"background: rgba(255,255,255,0.05); color: #fff; padding: 18px 40px; border-radius: 20px; font-weight: bold; text-decoration: none; backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.1);\">Ver Como Funciona</a>\n            </div>\n        </div>\n        <div class=\"hero-image\" style=\"position: relative;\">\n            <img src=\"https://zapmonei.com.br/wp-content/uploads/2026/05/zapmonei_hero_driver_1778630506684.jpg\" style=\"width: 100%; border-radius: 50px; box-shadow: 0 30px 100px rgba(0,0,0,0.8); border: 1px solid rgba(255,255,255,0.1);\">\n            <div class=\"chat-simulation\">\n                <div class=\"chat-bubble bubble-1\">\"Gastei R$ 50 de combustível agora\"</div>\n                <div class=\"chat-bubble bubble-2\"><strong>✅ Registrado!</strong><br>Seu lucro projetado hoje é de R$ 180. 🚀</div>\n            </div>\n        </div>\n    </div>\n</section>\n\n<section class=\"stats\" style=\"padding: 80px 0; background: rgba(255,255,255,0.02); border-top: 1px solid rgba(255,255,255,0.05); border-bottom: 1px solid rgba(255,255,255,0.05);\">\n    <div style=\"max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: repeat(4, 1fr); gap: 40px; text-align: center;\">\n        <div><div style=\"font-size: 3rem; font-weight: 900; color: #fff;\">5k+</div><div style=\"color: #CCFF00; text-transform: uppercase; font-size: 10px; font-weight: 900; letter-spacing: 2px;\">Motoristas Ativos</div></div>\n        <div><div style=\"font-size: 3rem; font-weight: 900; color: #fff;\">R$ 2M+</div><div style=\"color: #CCFF00; text-transform: uppercase; font-size: 10px; font-weight: 900; letter-spacing: 2px;\">Lucro Gerenciado</div></div>\n        <div><div style=\"font-size: 3rem; font-weight: 900; color: #fff;\">98%</div><div style=\"color: #CCFF00; text-transform: uppercase; font-size: 10px; font-weight: 900; letter-spacing: 2px;\">Satisfação</div></div>\n        <div><div style=\"font-size: 3rem; font-weight: 900; color: #fff;\">12s</div><div style=\"color: #CCFF00; text-transform: uppercase; font-size: 10px; font-weight: 900; letter-spacing: 2px;\">Tempo de Registro</div></div>\n    </div>\n</section>"
}
