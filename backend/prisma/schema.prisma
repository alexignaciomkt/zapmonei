datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                     String        @id @default(uuid()) @db.Uuid
  authUserId             String?       @unique @map("auth_user_id") @db.Uuid
  whatsappNumber         String        @unique @map("whatsapp_number")
  name                   String?       @map("nome")
  email                  String?       @unique
  planSlug               String?       @map("plan")
  whatsappInstanceName   String?       @unique @map("whatsapp_instance_name")
  whatsappInstanceToken  String?       @map("whatsapp_instance_token")
  onboardingStatus       String        @default("pending_kathy") @map("onboarding_status")
  onboardingStep         Int           @default(0) @map("onboarding_step")
  agentCustomName        String?       @map("agent_custom_name")
  controlType            String?       @map("control_type")
  isDriver               Boolean       @default(false) @map("is_driver")
  monthlyGoal            Decimal?      @map("monthly_goal") @db.Decimal(12, 2)
  whatsappSupportNumber  String?       @map("whatsapp_support_number")
  tutorialVisto          Boolean       @default(false) @map("tutorial_visto")
  password               String?       @map("password")
  copilotName            String?       @map("copilot_name")
  workRegime             String?       @map("work_regime")
  financialGoal          String?       @map("financial_goal")
  vehicleInfo            String?       @map("vehicle_info")
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")
  transactions           Transaction[]
}

model Transaction {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo         String
  valor        Decimal  @db.Decimal(12, 2)
  categoria    String?
  contexto     String?
  descricao    String?
  ocorrenciaEm DateTime @default(now()) @map("ocorrencia_em")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
}

model Audit {
  id          String   @id @default(uuid()) @db.Uuid
  entidade    String
  entidadeId  String   @map("entidade_id") @db.Uuid
  acao        String
  payloadDiff Json?    @map("payload_diff")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
}
