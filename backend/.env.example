# Configurações do Servidor
PORT=3000
NODE_ENV=development

# Banco de Dados (PostgreSQL VPS)
DATABASE_URL="postgresql://user:password@vps-ip:5432/zapmonei_db?schema=public"

# Cache e Filas
REDIS_URL="redis://localhost:6379"

# Evolution API
EVOLUTION_URL="https://api.evolution.com"
EVOLUTION_MASTER_KEY="sua_chave_mestra_evolution"

# Inteligência Artificial
GOOGLE_GEMINI_API_KEY="sua_gemini_api_key"

# Gateway de Pagamentos (Asaas)
ASAAS_API_KEY="sua_asaas_api_key"

# E-commerce (WooCommerce)
WOOCOMMERCE_URL="https://seu-wordpress.com"
WOOCOMMERCE_KEY="sua_woocommerce_consumer_key"
WOOCOMMERCE_SECRET="sua_woocommerce_consumer_secret"
